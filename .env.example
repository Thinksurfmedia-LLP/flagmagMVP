# Copy to .env.local and fill in real values. Never commit .env.local.

MONGODB_URI=
JWT_SECRET=

# PayPal (sandbox first — see https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Client-exposed by design (PayPal client ids are public) — must match PAYPAL_CLIENT_ID above.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Gmail sender for outbound notification emails (demo requests, org signup requests)
# — an app password (not the account password); requires 2FA enabled on the account.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Inbox notified of new demo/signup requests — defaults to GMAIL_USER if unset.
DEMO_REQUEST_NOTIFY_EMAIL=
