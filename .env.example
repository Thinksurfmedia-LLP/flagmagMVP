# Copy to .env.local and fill in real values. Never commit .env.local.

MONGODB_URI=
JWT_SECRET=

# PayPal (sandbox first — see https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Client-exposed by design (PayPal client ids are public) — must match PAYPAL_CLIENT_ID above.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
